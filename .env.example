MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=tabu
PORT=3000
# Public site URL: used for the link preview (og:image) when the page is shared.
PUBLIC_SITE_URL=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000
TURN_SECONDS_DEFAULT=60
MAX_TEAMS=4
MIN_PLAYERS_PER_TEAM=2
GAME_TTL_HOURS=24

# Administration is disabled until all three values are configured.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use a unique random secret of at least 32 characters.
ADMIN_SESSION_SECRET=

# Optional: required only for automatic deck generation and replacements.
DEEPSEEK_API_KEY=
